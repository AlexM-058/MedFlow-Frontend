# Optional for local startup; use your project's public/publishable key only.
# Never use a service-role key or database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backend origin or same-origin API prefix, e.g. http://127.0.0.1:3001 locally.
# HTTPS is required except localhost. No API secrets belong here.
VITE_API_BASE_URL=
